#!/bin/bash
# Generated by tools/build-release.py. Package bytes are checked before extraction.
set -euo pipefail

afan_install() {
  export PATH="${PATH:-}:/usr/bin:/bin:/usr/sbin:/sbin"
  case "$(uname -s)" in Darwin|Linux) ;; *) printf '此安装命令支持 macOS / Linux。\n' >&2; return 1 ;; esac
  local package_url="${AFAN_PACKAGE_URL:-https://github.com/__REPO__/releases/download/__TAG__/afan-qisi.tar.gz}"
  local expected='__SHA256__'
  local install_dir="${AFAN_INSTALL_DIR:-$HOME/.afan-qisi}"
  local bin_dir="${AFAN_BIN_DIR:-$HOME/.local/bin}"
  local temp actual rc line cleanup backup=''
  command -v curl >/dev/null || { printf '需要系统 curl 命令。\n' >&2; return 1; }
  command -v tar >/dev/null || { printf '需要系统 tar 命令。\n' >&2; return 1; }
  if [ -e "$bin_dir/afan-qisi" ] && ! LC_ALL=C grep -aFq '# afan-qisi managed launcher' "$bin_dir/afan-qisi"; then
    printf '已有其他同名命令，已停止安装并保留它：%s/afan-qisi\n' "$bin_dir" >&2
    return 1
  fi
  mkdir -p "$install_dir" "$bin_dir"
  temp="$(mktemp -d "$install_dir/.install.XXXXXX")"
  printf -v cleanup 'rm -rf -- %q' "$temp"
  trap "$cleanup" EXIT
  printf '阿凡启思｜下载程序中……\n'
  curl -fSL --retry 2 --connect-timeout 20 --max-time 300 \
    "$package_url" -o "$temp/afan-qisi.tar.gz"
  if command -v shasum >/dev/null; then
    actual="$(shasum -a 256 "$temp/afan-qisi.tar.gz" | awk '{print $1}')"
  elif command -v sha256sum >/dev/null; then
    actual="$(sha256sum "$temp/afan-qisi.tar.gz" | awk '{print $1}')"
  else
    printf '缺少 SHA-256 校验工具（shasum 或 sha256sum）。\n' >&2
    return 1
  fi
  [ "$actual" = "$expected" ] || { printf '程序包校验失败，已停止安装。\n' >&2; return 1; }
  tar -xzf "$temp/afan-qisi.tar.gz" -C "$temp"
  [ -f "$temp/afan-qisi/start.command" ] && [ -f "$temp/afan-qisi/server.js" ] \
    || { printf '程序包不完整，已停止安装。\n' >&2; return 1; }
  # 保留上一份安装，避免覆盖用户可能修改过的文件。
  if [ -d "$install_dir/app" ]; then
    backup="$(mktemp -d "$install_dir/previous.XXXXXX")"
    mv "$install_dir/app" "$backup/app"
  fi
  if ! mv "$temp/afan-qisi" "$install_dir/app"; then
    [ -z "$backup" ] || mv "$backup/app" "$install_dir/app"
    return 1
  fi
  chmod +x "$install_dir/app/start.command"
  # %q 写出合法 shell 路径，支持用户名或目录中含空格和特殊字符。
  {
    printf '#!/bin/bash\n# afan-qisi managed launcher\n'
    printf 'exec /bin/bash %q "$@"\n' "$install_dir/app/start.command"
  } > "$temp/afan-qisi"
  chmod +x "$temp/afan-qisi"
  mv "$temp/afan-qisi" "$bin_dir/afan-qisi"
  if [ "${AFAN_NO_PATH_SETUP:-0}" != 1 ]; then
    # 只追加本程序的 PATH 设置，不重写既有终端配置。
    printf -v line 'export PATH=%q:"$PATH" # afan-qisi' "$bin_dir"
    for rc in "${ZDOTDIR:-$HOME}/.zshrc" "$HOME/.bashrc" "$HOME/.profile"; do
      if ! grep -Fq '# afan-qisi' "$rc" 2>/dev/null; then
        printf '\n%s\n' "$line" >> "$rc"
      fi
    done
    if [ -f "$HOME/.bash_profile" ] && ! grep -Fq '# afan-qisi' "$HOME/.bash_profile"; then
      printf '\n%s\n' "$line" >> "$HOME/.bash_profile"
    fi
  fi
  rm -rf "$temp"
  trap - EXIT
  printf '\n安装完成。以后新开终端，输入 afan-qisi 即可启动。\n'
  if [ "${AFAN_INSTALL_ONLY:-0}" != 1 ]; then
    exec "$bin_dir/afan-qisi" "$@"
  fi
}

# 最后一行才执行，避免网络中断时执行不完整的函数体。
afan_install "$@"
